# Local environment variables
#
# Copy this file to .env and modify the values as needed.
#
# Do not commit your .env file to version control.
#
# For more information, see https://docs.docker.com/compose/env-file/

MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_PASSWORD=replace-with-a-random-app-password
JWT_SECRET=replace-with-at-least-32-random-characters
# SMTP 邮件服务（不配置时服务可启动，但发送验证码会报错）
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-with-your-smtp-password
MAIL_FROM=noreply@example.com
MAIL_TLS=true
